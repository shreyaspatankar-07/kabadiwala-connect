{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EWasteLotSubmission",
  "type": "object",
  "required": [
    "client_lot_id",
    "category",
    "estimated_weight_kg",
    "created_at_utc",
    "latitude",
    "longitude"
  ],
  "properties": {
    "client_lot_id": {
      "type": "string",
      "format": "uuid"
    },
    "category": {
      "type": "string",
      "enum": [
        "pcb_grade_a",
        "pcb_grade_b",
        "pcb_grade_c",
        "lithium_ion_battery",
        "crt_monitor",
        "flat_display",
        "copper_cable_heavy",
        "mixed_e_waste"
      ]
    },
    "estimated_weight_kg": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 50000.0
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "latitude": {
      "type": "number",
      "minimum": -90.0,
      "maximum": 90.0
    },
    "longitude": {
      "type": "number",
      "minimum": -180.0,
      "maximum": 180.0
    },
    "photo_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$"
      }
    }
  }
}
